# Copy to .env and fill in. NEVER commit .env.

# --- Apify (macro calendar) ---
APIFY_TOKEN=
APIFY_CALENDAR_ACTOR_ID=            # e.g. username~actor-name  (the economic-calendar actor you use)
APIFY_SOURCE_TZ=UTC                 # timezone of naive timestamps returned by the actor
# Optional: raw actor input as JSON. {start_date} / {end_date} (YYYY-MM-DD) are substituted.
# APIFY_CALENDAR_INPUT_JSON={"startDate": "{start_date}", "endDate": "{end_date}", "countries": ["US"]}

# --- Tavily (recent macro news) ---
TAVILY_API_KEY= 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

