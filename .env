# Copy to .env and fill in. NEVER commit .env, and never put real keys in this example file.

# --- Apify (macro calendar) ---
APIFY_TOKEN=
APIFY_CALENDAR_ACTOR_ID=            # e.g. username~actor-name  (the Investing.com economic-calendar actor you ran)
APIFY_SOURCE_TZ=UTC                 # timezone of naive timestamps returned by the actor
# Optional: raw actor input as JSON. {start_date} / {end_date} (YYYY-MM-DD) are substituted.
# APIFY_CALENDAR_INPUT_JSON={"startDate": "{start_date}", "endDate": "{end_date}", "countries": ["US"]}

# --- Tavily (recent macro news) ---
TAVILY_API_KEY=

# --- Exa (second news source) ---
EXA_API_KEY=

# --- LLM for the written macro outlook (optional; used by `python main.py --proxy --llm`) ---
# Set ONE of the two keys. Without a key the pipeline falls back to the rule-based outlook.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic            # anthropic | openai (auto-detected from whichever key is set)
# LLM_MODEL=                        # override the default model name
